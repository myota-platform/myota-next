# Local development only. Copy to deploy/.env and replace these credentials.
POSTGRES_PASSWORD=myota-dev-only
MYOTA_AUTH_SIGNING_KEY=myota-local-development-signing-key-change-me
MYOTA_IMPORT_MAX_FEATURE_BYTES=16777216
MYOTA_EMAIL_SERVICE_CLIENT_SECRET=myota-local-email-service-secret-32-chars-minimum
MYOTA_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
MYOTA_BOOTSTRAP_ADMIN_PASSWORD=replace-this-local-password

# Local JetStream capacity limits; these are not production recommendations.
NATS_TOPOLOGY_APPLY=1
NATS_EVENTS_MAX_BYTES=268435456
NATS_EVENTS_MAX_MESSAGES=100000
NATS_EVENTS_MAX_MESSAGE_BYTES=900000
NATS_ACTIVITY_WORK_MAX_AGE_SECONDS=604800
NATS_ACTIVITY_WORK_MAX_BYTES=1073741824
NATS_ACTIVITY_WORK_MAX_MESSAGES=100000
NATS_ACTIVITY_WORK_MAX_MESSAGE_BYTES=900000
NATS_GEODATA_WORK_MAX_AGE_SECONDS=1209600
NATS_GEODATA_WORK_MAX_BYTES=1073741824
NATS_GEODATA_WORK_MAX_MESSAGES=100000
NATS_GEODATA_WORK_MAX_MESSAGE_BYTES=900000
GEODATA_WORKER_PREPROCESSING_MAX_ACK_PENDING=1
GEODATA_WORKER_PROMOTION_MAX_ACK_PENDING=1
GEODATA_WORKER_DELETION_MAX_ACK_PENDING=1
GEODATA_WORKER_ENRICHMENT_MAX_ACK_PENDING=4
# Legacy concurrency aliases accepted by matching Geodata durable consumers.
MYOTA_DELETION_WORKERS=
MYOTA_LOCATION_WORKERS=
NATS_EMAIL_WORK_MAX_AGE_SECONDS=2592000
NATS_EMAIL_WORK_MAX_BYTES=268435456
NATS_EMAIL_WORK_MAX_MESSAGES=100000
NATS_EMAIL_WORK_MAX_MESSAGE_BYTES=900000
