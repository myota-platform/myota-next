# Local development only. Replace before sharing a deployment environment.
POSTGRES_PASSWORD=myota-dev-only
MYOTA_AUTH_SIGNING_KEY=myota-local-development-signing-key-change-me
MYOTA_OBJECT_STORAGE_ACCESS_KEY=myota-s3
MYOTA_OBJECT_STORAGE_SECRET_KEY=myota-s3-dev-only
MYOTA_PROFILE_IMAGE_ACCESS_KEY=myota-profile-image
MYOTA_PROFILE_IMAGE_SECRET_KEY=myota-profile-image-dev-only
MYOTA_EMAIL_SERVICE_CLIENT_SECRET=myota-local-email-service-secret-32-chars-minimum
EMAIL_SENDER_ADDRESS=myota@example.test
GEODATA_IMPORTER_ENABLED=false
GEODATA_SOURCE_ALLOWLIST=
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
MYOTA_BUILD_VERSION=local

# Explicit finite local JetStream capacity limits. These are development values,
# not production sizing recommendations.
NATS_TOPOLOGY_APPLY=1
NATS_EVENTS_MAX_BYTES=67108864
NATS_EVENTS_MAX_MESSAGES=50000
NATS_EVENTS_MAX_MESSAGE_BYTES=1048576
NATS_ACTIVITY_WORK_MAX_AGE_SECONDS=604800
NATS_ACTIVITY_WORK_MAX_BYTES=67108864
NATS_ACTIVITY_WORK_MAX_MESSAGES=10000
NATS_ACTIVITY_WORK_MAX_MESSAGE_BYTES=1048576
NATS_GEODATA_WORK_MAX_AGE_SECONDS=604800
NATS_GEODATA_WORK_MAX_BYTES=67108864
NATS_GEODATA_WORK_MAX_MESSAGES=10000
NATS_GEODATA_WORK_MAX_MESSAGE_BYTES=1048576
NATS_EMAIL_WORK_MAX_AGE_SECONDS=604800
NATS_EMAIL_WORK_MAX_BYTES=16777216
NATS_EMAIL_WORK_MAX_MESSAGES=10000
NATS_EMAIL_WORK_MAX_MESSAGE_BYTES=8192
