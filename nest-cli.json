{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/identity",
  "sourceRoot": "apps/identity/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/identity/tsconfig.app.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" }
    },
    "identity": {
      "type": "application",
      "root": "apps/identity",
      "entryFile": "main",
      "sourceRoot": "apps/identity/src",
      "compilerOptions": { "tsConfigPath": "apps/identity/tsconfig.app.json" }
    },
    "programmes": {
      "type": "application",
      "root": "apps/programmes",
      "entryFile": "main",
      "sourceRoot": "apps/programmes/src",
      "compilerOptions": { "tsConfigPath": "apps/programmes/tsconfig.app.json" }
    },
    "activity": {
      "type": "application",
      "root": "apps/activity",
      "entryFile": "main",
      "sourceRoot": "apps/activity/src",
      "compilerOptions": { "tsConfigPath": "apps/activity/tsconfig.app.json" }
    },
    "geodata": {
      "type": "application",
      "root": "apps/geodata",
      "entryFile": "main",
      "sourceRoot": "apps/geodata/src",
      "compilerOptions": { "tsConfigPath": "apps/geodata/tsconfig.app.json" }
    },
    "activity-worker": {
      "type": "application",
      "root": "apps/activity-worker",
      "entryFile": "main",
      "sourceRoot": "apps/activity-worker/src",
      "compilerOptions": { "tsConfigPath": "apps/activity-worker/tsconfig.app.json" }
    },
    "activity-notifications": {
      "type": "application",
      "root": "apps/activity-notifications",
      "entryFile": "main",
      "sourceRoot": "apps/activity-notifications/src",
      "compilerOptions": { "tsConfigPath": "apps/activity-notifications/tsconfig.app.json" }
    },
    "geodata-worker": {
      "type": "application",
      "root": "apps/geodata-worker",
      "entryFile": "main",
      "sourceRoot": "apps/geodata-worker/src",
      "compilerOptions": { "tsConfigPath": "apps/geodata-worker/tsconfig.app.json" }
    },
    "email-worker": {
      "type": "application",
      "root": "apps/email-worker",
      "entryFile": "main",
      "sourceRoot": "apps/email-worker/src",
      "compilerOptions": { "tsConfigPath": "apps/email-worker/tsconfig.app.json" }
    },
    "platform": {
      "type": "library",
      "root": "libs/platform",
      "entryFile": "index",
      "sourceRoot": "libs/platform/src",
      "compilerOptions": { "tsConfigPath": "libs/platform/tsconfig.lib.json" }
    }
  }
}
