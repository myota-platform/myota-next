{
  "name": "@myota-platform/myota-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:apis && npm run build:workers",
    "build:apis": "nest build gateway && nest build identity && nest build programmes && nest build activity && nest build geodata",
    "build:workers": "nest build identity-maintenance && nest build activity-worker && nest build activity-notifications && nest build geodata-worker && nest build geodata-importer && nest build email-worker && nest build outbox-worker",
    "start:gateway": "nest start gateway",
    "start:identity": "nest start identity",
    "start:programmes": "nest start programmes",
    "start:activity": "nest start activity",
    "start:geodata": "nest start geodata",
    "start:geodata-importer": "nest start geodata-importer",
    "start:gateway:dev": "nest start gateway --watch",
    "start:identity:dev": "nest start identity --watch",
    "start:programmes:dev": "nest start programmes --watch",
    "start:activity:dev": "nest start activity --watch",
    "start:geodata:dev": "nest start geodata --watch",
    "start:identity-maintenance": "nest start identity-maintenance",
    "start:activity-worker": "nest start activity-worker",
    "start:activity-notifications": "nest start activity-notifications",
    "start:geodata-worker": "nest start geodata-worker",
    "start:outbox-worker": "nest start outbox-worker",
    "start:email-worker": "nest start email-worker",
    "start:outbox-worker:dev": "nest start outbox-worker --watch",
    "migrate:db": "node --experimental-strip-types tools/db-migrate.ts",
    "db:backup": "node --experimental-strip-types tools/db-backup.ts",
    "db:restore": "node --experimental-strip-types tools/db-restore.ts",
    "object-store:backup": "node tools/s3-backup.mjs backup",
    "object-store:restore": "node tools/s3-backup.mjs restore",
    "test:db-backup-restore": "node tools/run-db-backup-restore.mjs",
    "provision:jetstream": "node --experimental-strip-types tools/provision-jetstream.ts",
    "outbox:admin": "node --experimental-strip-types tools/outbox-admin.ts",
    "redrive:email": "node --experimental-strip-types apps/email-worker/src/redrive-email.ts",
    "redrive:activity-notification": "node --experimental-strip-types apps/activity-notifications/src/redrive-notification.ts",
    "test": "vitest run",
    "audit:dependencies": "npm audit --audit-level=low && npm audit --audit-level=low --prefix web/admin",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:browser": "playwright test",
    "test:geodata-maidenhead": "node tools/check-geodata-maidenhead.mjs",
    "test:geodata-rss": "node tools/run-geodata-rss-qualification.mjs",
    "test:geodata-pbf-rss": "node tools/run-geodata-pbf-rss-qualification.mjs",
    "test:activity-capacity": "node tools/run-activity-capacity-qualification.mjs",
    "test:activity-capacity-live": "node tools/run-live-activity-capacity.mjs",
    "test:geodata-capacity": "node tools/run-geodata-capacity-qualification.mjs",
    "test:geodata-worker-recovery": "node tools/run-geodata-worker-recovery.mjs",
    "test:geodata-storage-recovery": "node tools/run-geodata-storage-recovery.mjs",
    "test:activity-worker-recovery": "node tools/run-activity-worker-recovery.mjs",
    "test:activity-notification-restart-recovery": "node tools/run-activity-notification-restart-recovery.mjs",
    "test:email-worker-recovery": "node tools/run-email-worker-recovery.mjs",
    "test:outbox-recovery": "node tools/run-outbox-recovery.mjs",
    "prepare:parity-databases": "node tools/create-parity-databases.mjs",
    "docs:api-traceability": "node tools/generate-api-operation-traceability.mjs",
    "docs:api-traceability:check": "node tools/generate-api-operation-traceability.mjs --check",
    "lint": "oxlint --type-aware apps libs tools && node tools/check-nest-observability.mjs && node tools/check-database-ownership.mjs && node tools/check-openapi-nest-routes.mjs && node tools/check-gateway-openapi-routes.mjs && node tools/check-exact-json-integers.mjs && node tools/generate-api-operation-traceability.mjs --check",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"tools/**/*.{ts,mjs}\" playwright.config.mjs tsconfig.playwright.json \"web/admin/*.{ts,html,json}\" \"web/admin/tests/**/*.ts\" \"web/participant/web/**/*.{js,css,html}\" \".github/workflows/**/*.yml\" \"docs/**/*.md\" \"deploy/**/*.md\" \"web/**/*.md\" README.md",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\" \"tools/**/*.{ts,mjs}\" playwright.config.mjs tsconfig.playwright.json \"web/admin/*.{ts,html,json}\" \"web/admin/tests/**/*.ts\" \"web/participant/web/**/*.{js,css,html}\" \".github/workflows/**/*.yml\" \"docs/**/*.md\" \"deploy/**/*.md\" \"web/**/*.md\" README.md",
    "typecheck": "tsc --build --pretty false && tsc --ignoreConfig --noEmit --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node tools/db-owner-config.ts tools/db-migrate.ts tools/db-backup.ts tools/db-restore.ts tools/provision-jetstream.ts tools/outbox-admin.ts tools/render-seaweedfs-s3-config.ts && tsc --project tsconfig.playwright.json --pretty false",
    "check:nest-observe-workspaces": "node tools/check-nest-observe-workspaces.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/observe": "^0.3.17",
    "@nestjs/platform-express": "12.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@streamparser/json": "^0.0.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "geotiff": "3.0.5",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "proj4": "^2.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sax": "^1.6.1",
    "shapefile": "file:vendor/shapefile",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@playwright/test": "^1.64.1",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/sax": "^1.2.7",
    "@types/shapefile": "^0.6.4",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  },
  "workspaces": [
    "apps/*"
  ]
}
