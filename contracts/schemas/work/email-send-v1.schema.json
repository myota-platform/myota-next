{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myota-platform/myota-contracts/contracts/schemas/work/email-send-v1.schema.json",
  "title": "email.send.v1 command envelope v1",
  "allOf": [
    {
      "$ref": "../work-command.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "workType": {
          "const": "email.send.v1"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "recipientAccountId",
            "templateId",
            "templateData"
          ],
          "properties": {
            "recipientAccountId": {
              "type": "string",
              "format": "uuid",
              "maxLength": 36
            },
            "templateId": {
              "type": "string",
              "enum": [
                "account-created-participant.v1",
                "account-created-administrator.v1",
                "participant-email-verification.v1",
                "password-reset.v1",
                "participant-email-change-old.v1",
                "participant-email-change-new.v1",
                "participant-email-change-complete-old.v1",
                "participant-email-change-complete-new.v1"
              ],
              "maxLength": 40
            },
            "templateData": {
              "type": "object"
            },
            "requestId": {
              "type": "string",
              "format": "uuid",
              "maxLength": 36
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "properties": {
                    "templateId": {
                      "const": "account-created-participant.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "account-created-administrator.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["createdAccountName", "createdAccountRole"],
                      "properties": {
                        "createdAccountName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "createdAccountRole": {
                          "type": "string",
                          "enum": ["PARTICIPANT", "ADMINISTRATOR"],
                          "maxLength": 20
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "password-reset.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "participant-email-verification.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName", "verificationUrl"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "verificationUrl": {
                          "type": "string",
                          "format": "uri",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "participant-email-change-old.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName", "changeId"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "changeId": {
                          "type": "string",
                          "format": "uuid",
                          "maxLength": 36
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "participant-email-change-new.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName", "changeId"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "changeId": {
                          "type": "string",
                          "format": "uuid",
                          "maxLength": 36
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "participant-email-change-complete-old.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName", "changeId"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "changeId": {
                          "type": "string",
                          "format": "uuid",
                          "maxLength": 36
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "templateId": {
                      "const": "participant-email-change-complete-new.v1"
                    },
                    "templateData": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["displayName", "changeId"],
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "changeId": {
                          "type": "string",
                          "format": "uuid",
                          "maxLength": 36
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "x-payload-evidence": "proposed-versioned-allowlisted-template-reference; approved by email workstream decisions",
  "x-work-id-source": "email.send.v1 payload requestId, matched to outbox aggregate ID",
  "x-producer-sources": [
    "apps/identity/src/auth.service.ts",
    "apps/identity/src/identity-registration.service.ts"
  ],
  "x-consumer-sources": ["apps/email-worker/src/email-command.ts"],
  "x-max-payload-bytes": 8192,
  "x-delivery-semantics": "at-least-once; explicit acknowledgement after durable outcome; unknown version/template is never success-acked; transient failures retry under deployment-bounded policy; ambiguous SMTP acceptance can duplicate"
}
